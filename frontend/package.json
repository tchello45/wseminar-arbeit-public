{
  "name": "frontend",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "python3 -m http.server 3000 --directory out",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "data:export": "node scripts/export-data.mjs",
    "predev": "pnpm wasm:prepare && pnpm data:export",
    "prebuild": "pnpm wasm:prepare && pnpm data:export",
    "test": "pnpm wasm:prepare && pnpm data:export && node --test tests/model.test.ts",
    "wasm:build": "node scripts/build-wasm.mjs",
    "wasm:pack": "pnpm wasm:build && mkdir -p vendor && pnpm --dir ../css-wasm/pkg pack --pack-destination ../../frontend/vendor",
    "wasm:prepare": "node scripts/prepare-wasm.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.4",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.19.1",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tw-animate-css": "^1.4.0",
    "@wseminar/css-wasm": "file:vendor/wseminar-css-wasm-0.1.0.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
